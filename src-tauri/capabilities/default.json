{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for main window with full disk access",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-text",
      "allow": [
        { "path": "C:\\**" },
        { "path": "D:\\**" },
        { "path": "E:\\**" },
        { "path": "F:\\**" },
        { "path": "\\\\**" },
        { "path": "$HOME\\**" },
        { "path": "**" }
      ]
    },
    {
      "identifier": "fs:allow-read-binary",
      "allow": [
        { "path": "C:\\**" },
        { "path": "D:\\**" },
        { "path": "E:\\**" },
        { "path": "F:\\**" },
        { "path": "\\\\**" },
        { "path": "$HOME\\**" },
        { "path": "**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "C:\\**" },
        { "path": "D:\\**" },
        { "path": "E:\\**" },
        { "path": "F:\\**" },
        { "path": "\\\\**" },
        { "path": "$HOME\\**" },
        { "path": "**" }
      ]
    }
  ]
}
