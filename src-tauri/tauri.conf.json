{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:3000",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "QueryAST Lens",
    "version": "7.3.1"
  },
  "tauri": {
    "allowlist": {
      "all": true,
      "http": {
        "all": true,
        "request": true,
        "scope": [
          "http://*/**",
          "https://*/**"
        ]
      },
      "fs": {
        "all": true,
        "readFile": true,
        "exists": true,
        "scope": [
          "$HOME/**",
          "/**",
          "C:/**",
          "D:/**",
          "E:/**",
          "F:/**"
        ]
      },
      "dialog": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.sqlflow.visualizer",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "title": "QueryAST Lens",
        "width": 1600,
        "height": 1000,
        "resizable": true,
        "fileDropEnabled": false
      }
    ]
  }
}
