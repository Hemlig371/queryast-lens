    "@types/dagre": "^0.7.54",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.11.2",
    "dagre": "^0.8.5",
    "dotenv": "^17.2.3",
    "duckdb": "^1.4.4",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
