        "sql": "CREATE OR REPLACE MACRO db_extract(conn, query:='SELECT 1 FROM DUAL', output:='./export/file.csv', \ndriver:='Path_to_file/instantclient_23_26/db-extractor.exe') AS (\n    SELECT content as stout FROM read_text(\n        driver || ' --conn \"' || conn || '\" --query \"' || replace(query, '\"', '\\\"')\n        || '\" --out \"' || output || '\" --cast-universal |'\n    ));\n/* --------------- */\nCREATE OR REPLACE MACRO db_extract_file(conn, query_file, output:='./export/file.csv', \ndriver:='Path_to_file/instantclient_23_26/db-extractor.exe') AS (\n    SELECT content as stout FROM read_text(\n        driver || ' --conn \"' || conn || '\" --query-file \"' || query_file\n        || '\" --out \"' || output || '\" --cast-universal |'\n    ));",
