    "sql_visualizer_snippets": [
      {
        "id": "act-ch-processes",
        "title": "ClickHouse: Активные запросы (Processes)",
        "category": "Меню действий",
        "sql": "SELECT query_id, user, elapsed, formatReadableSize(memory_usage) AS memory, query FROM system.processes WHERE is_initial_query = 1;",
        "description": "Мониторинг текущих выполняющихся запросов и потребления ресурсов в ClickHouse.",
        "dialect": "Clickhouse",
        "isCustom": true
      },
      {
        "id": "act-ch-tables",
        "title": "ClickHouse: Список таблиц и их размер",
        "category": "Меню действий",
        "sql": "SELECT name, total_rows, formatReadableSize(total_bytes) AS size, engine FROM system.tables WHERE database = currentDatabase() ORDER BY total_bytes DESC;",
        "description": "Вывод всех таблиц текущей базы данных ClickHouse с подсчетом количества строк и занимаемого объема.",
        "dialect": "Clickhouse",
        "isCustom": true
      },
      {
        "id": "custom-1785852527900-jpz5r",
        "title": "Вес таблицы на диске",
        "category": "Stats",
        "sql": "WITH block_info AS (\n\t\tSELECT CAST(block_size AS BIGINT) AS block_size\n\t\tFROM pragma_database_size()\n\t), table_storage AS (\n\t\tSELECT COUNT(DISTINCT block_id) AS num_blocks\n\t\tFROM pragma_storage_info('table')\n\t\tWHERE persistent=TRUE\n\t\t\tAND block_id IS NOT NULL\n\t)\nSELECT ((num_blocks*block_size)/1024/1024)::TEXT||' MB' AS size_in_mb\nFROM block_info, table_storage;",
        "description": "",
        "dialect": "DuckDB",
        "isCustom": true
      },
      {
        "id": "custom-1786305467291-p9nzq",
        "title": "DB-Extractor",
        "category": "Tools",
        "sql": "LOAD shellfs;\n\nSET VARIABLE uri = '\"postgresql://user:password@host:port/db\"';\nSET VARIABLE sql = '\"SELECT * FROM table\"';\n\nSELECT * FROM read_text(\n    'db-extractor.exe --conn '|| getvariable('uri') ||\n    ' --query '|| getvariable('sql') || \n    ' --out \"file.parquet\" |')",
        "description": "",
        "dialect": "DuckDB",
        "isCustom": true
      },
      {
        "id": "custom-1786427000878-jt9xz",
        "title": "ATTACH Postgres",
        "category": "Tools",
        "sql": "ATTACH 'dbname=postgres user=postgres host=127.0.0.1' AS db (TYPE postgres, READ_ONLY);\n/* --------------- */\nATTACH '' AS postgres_db_one (TYPE postgres, SECRET postgres_secret_one);",
        "description": "",
        "dialect": "DuckDB",
        "isCustom": true
      },
      {
        "id": "custom-1786427034231-kzapb",
        "title": "CREATE SECRET",
        "category": "Tools",
        "sql": "CREATE SECRET postgres_secret_one (\n    TYPE postgres,\n    HOST '127.0.0.1',\n    PORT 5432,\n    DATABASE postgres,\n    USER 'postgres',\n    PASSWORD ''\n);",
        "description": "",
        "dialect": "DuckDB",
        "isCustom": true
      },
      {
        "id": "custom-1786949595095-vi3t9",
        "title": "Import notebook definition",
        "category": "Duckdb UI",
        "sql": "set variable notebook_content = (select json from 'exported-notebook.json');\nset variable notebook_id = uuid();\nset variable current_timestamp = now();\n\nbegin transaction;\n  insert into _duckdb_ui.notebooks (id, name, created)\n  select\n    getvariable('notebook_id'),\n    'notebook_' || getvariable('notebook_id'),\n    getvariable('current_timestamp')\n  ;\n\n  insert into _duckdb_ui.notebook_versions (notebook_id, version, title, json, created, expires)\n  select\n    getvariable('notebook_id'),\n    1,\n    'imported-notebook-' || getvariable('current_timestamp'),\n    getvariable('notebook_content'),\n    getvariable('current_timestamp'),\n    null\n  ;\ncommit;",
        "description": "",
        "dialect": "DuckDB",
        "isCustom": true
      },
      {
        "id": "custom-1786949616023-ute8i",
        "title": "Export a notebook definition to JSON",
        "category": "Duckdb UI",
        "sql": "copy (\n  select\n    \"json\"\n  from _duckdb_ui.notebook_versions\n  where 1=1\n    and title = 'MySingleNotebook'\n    and expires is null\n) to 'exported-notebook.json'",
        "description": "",
        "dialect": "DuckDB",
        "isCustom": true
      },
      {
        "id": "custom-1786955436397-nrcwn",
        "title": "ATTACH Encrypt DB",
